# ---- Anthropic ----
CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-haiku-5-5"
CLAUDE_TIMEOUT_SECONDS=20
CLAUDE_MAX_CONCURRENT_CALLS=5

# ---- Image fetching ----
ALLOWED_IMAGE_HOSTS=["web.cs.wpi.edu"]
ALLOWED_IMAGE_TYPES=["image/jpg","image/jpeg","image/png"]
FETCH_TIMEOUT_SECONDS=10
MAX_IMAGE_BYTES=10.0e6
FETCH_USER_AGENT="Joe Tolsma/1.0 (tolsmajdx@gmail.com) - self-study project to learn asynchronous Python"

# ---- Fake extractor (for credit-free concurrency tests) ----
USE_FAKE_EXTRACTOR=false
FAKE_EXTRACTOR_SLEEP_RANGE="2.4,4.1"

# --- Other ---
MAX_ATTEMPTS=2
